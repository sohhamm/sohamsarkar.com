---
import {ClientRouter} from 'astro:transitions'
import Analytics from '@vercel/analytics/astro'
import MainHead from '../components/MainHead.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import FooterHorizon from '../components/effects/FooterHorizon.astro'

interface Props {
  content: {
    title: string
    description: string
    canonicalUrl?: string
    ogImage?: string
    ogType?: string
    twitterCard?: string
    noindex?: boolean
    structuredData?: object
  }
}

const {content} = Astro.props as Props
const {title, description, ...rest} = content
---

<html lang={'en'}>
  <head>
    <MainHead title={title} description={description} {...rest} />
    <ClientRouter />
  </head>
  <body>
    <Analytics />

    <Nav transition:persist />
    <main class="main-content">
      <div class="container">
        <slot />
        <Footer transition:persist />
      </div>
      {
        /* Persisted alongside the footer, so the wordmark keeps its state
          through a view transition instead of re-mounting on every page. */
      }
      <FooterHorizon transition:persist />
    </main>

    <script>
      // Reveals `.reveal` elements on scroll by adding `.is-revealed`.
      // Deliberately class-only — see the note in styles/global.css.
      const REVEAL_FAILSAFE_MS = 2500

      function revealAll(els: Iterable<Element>) {
        for (const el of els) el.classList.add('is-revealed')
      }

      function initReveal() {
        const els = document.querySelectorAll('.reveal:not(.is-revealed)')
        if (els.length === 0) return

        if (!('IntersectionObserver' in window)) {
          revealAll(els)
          return
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('is-revealed')
              obs.unobserve(entry.target)
            }
          },
          {threshold: 0, rootMargin: '0px 0px -80px 0px'},
        )

        els.forEach(el => observer.observe(el))

        // Nothing should ever stay hidden because an observer didn't fire.
        window.setTimeout(() => {
          revealAll(document.querySelectorAll('.reveal:not(.is-revealed)'))
          observer.disconnect()
        }, REVEAL_FAILSAFE_MS)
      }

      initReveal()
      document.addEventListener('astro:page-load', initReveal)
      // Never hand a half-faded snapshot to a view transition.
      document.addEventListener('astro:before-swap', () =>
        revealAll(document.querySelectorAll('.reveal:not(.is-revealed)')),
      )
    </script>

    <style>
      .main-content {
        width: 100%;
        padding-top: 100px;
        position: relative;
        z-index: 2;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding-left: 20px;
        padding-right: 20px;
        position: relative;
        z-index: 2;
      }

      @media (max-width: 768px) {
        .main-content {
          padding-top: 64px;
        }
      }
    </style>
  </body>
</html>
