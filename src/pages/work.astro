---
import Layout from '../layouts/layout.astro'
import Button from '../components/Button.astro'
import {Icon} from 'astro-icon/components'
import {productDomain, productUrl, products} from '../data/products'

const CAL_LINK = 'https://cal.com/soham-sarkar-work'
const EMAIL = 'mailto:sohamsarkar.work@gmail.com?subject=Working%20together'

const services = [
  {
    title: 'Architecture & code review',
    description:
      'You bring a codebase or a design you are unsure about. I go through it and tell you what will break, what to cut, and what to build next — in writing, so your team can act on it.',
    points: [
      'Frontend & full-stack architecture',
      'Performance and build tooling',
      'Written follow-up',
    ],
  },
  {
    title: 'Product & technical advisory',
    description:
      'Ongoing sounding board for founders and small teams. Scoping an MVP, choosing a stack, deciding what is worth building — the calls you want to have before committing three months to something.',
    points: ['MVP scoping', 'Stack and trade-off decisions', 'Hiring & team structure'],
  },
  {
    title: 'Career guidance',
    description:
      'For engineers deciding what to do next. Levelling up, moving into lead roles, interview prep, or working out whether to go build your own thing. I have done all three.',
    points: ['IC → lead transitions', 'Interview preparation', 'Honest feedback'],
  },
]

const track = [
  {
    company: 'ZenAdmin',
    url: 'https://zenadmin.ai/',
    role: 'Founding Engineer → Technical Lead',
    period: '2022 — Present',
    note: 'Shipped the production MVP in 2 months, then grew into leading a team of five. Cut load times 40% and deployment time 80%.',
  },
  {
    company: 'GreedyGame',
    url: 'https://greedygame.com/',
    role: 'Frontend Developer',
    period: '2021 — 2022',
    note: 'Publisher analytics dashboards. Lifted Lighthouse scores from 60 to 90+ and cut build times 70% by moving Webpack to esbuild.',
  },
  {
    company: 'Tellephant',
    url: 'https://www.linkedin.com/company/tellephanthq/',
    role: 'Full Stack Developer',
    period: '2021',
    note: 'Built and launched a buyer-facing e-commerce platform from scratch. Checkout and UX work drove 3x revenue growth.',
  },
]

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Soham Sarkar — Engineering Consulting',
  description:
    'Architecture reviews, product and technical advisory, and career guidance from a founding engineer and technical lead.',
  url: 'https://sohamsarkar.com/work',
  areaServed: 'Worldwide',
  provider: {
    '@type': 'Person',
    name: 'Soham Sarkar',
    jobTitle: 'Technical Lead',
    url: 'https://sohamsarkar.com',
  },
}

const content = {
  title: 'Work with me | Soham Sarkar',
  description:
    'Architecture reviews, technical advisory and career guidance from a founding engineer turned technical lead who ships and runs his own products.',
  structuredData,
}
---

<Layout content={content}>
  <section class="work-page">
    <header class="page-header reveal">
      <span class="section-label">Work with me</span>
      <h1>I've shipped the thing you're about to build.</h1>
      <p class="lede">
        Founding engineer turned technical lead — and I run three of my own products. So the advice
        you get is from someone who still has to live with the decisions, not someone who moved on
        to slides.
      </p>
      <div class="header-actions">
        <Button href={CAL_LINK} target="_blank" rel="noopener noreferrer">
          Book a session <Icon name="arrow-right" />
        </Button>
        <Button href={EMAIL} variant="secondary">Email me first</Button>
      </div>
    </header>

    <section class="services" aria-labelledby="services-heading">
      <h2 id="services-heading" class="sr-only">What I help with</h2>
      {
        services.map((service, index) => (
          <article class="service reveal" style={`--reveal-delay: ${index * 80}ms`}>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <ul>
              {service.points.map(point => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="proof reveal" aria-labelledby="proof-heading">
      <div class="proof-header">
        <span class="section-label">Proof</span>
        <h2 id="proof-heading">Products I actually run</h2>
        <p>
          Not case studies from a deck — live software with real users, where I own every decision.
        </p>
      </div>

      <ul class="product-strip">
        {
          products.map(product => (
            <li>
              <a href={productUrl(product.link)} target="_blank" rel="noopener noreferrer">
                <span class="product-name">{product.title}</span>
                <span class="product-meta">
                  {product.category} · {product.status}
                </span>
                <span class="product-domain">{productDomain(product.link)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="track reveal" aria-labelledby="track-heading">
      <div class="proof-header">
        <span class="section-label">Track record</span>
        <h2 id="track-heading">And the teams I've built with</h2>
      </div>

      <ol class="track-list">
        {
          track.map(item => (
            <li>
              <div class="track-head">
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.company}
                </a>
                <span class="track-period">{item.period}</span>
              </div>
              <p class="track-role">{item.role}</p>
              <p class="track-note">{item.note}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <aside class="closing reveal">
      <h2>Bring me a real problem.</h2>
      <p>
        Sessions are paid — you'll see the rate when you pick a time. If you'd rather scope things
        out over email first, that works too.
      </p>
      <div class="header-actions">
        <Button href={CAL_LINK} target="_blank" rel="noopener noreferrer">
          Book a session <Icon name="arrow-right" />
        </Button>
        <Button href={EMAIL} variant="secondary">Email me</Button>
      </div>
    </aside>
  </section>
</Layout>

<style>
  .work-page {
    padding: 32px 0 40px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 720px;
    margin-bottom: 72px;
  }

  h1 {
    color: var(--text-primary);
    font-size: clamp(2.25rem, 6.5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .lede {
    color: var(--text-dim);
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 4px 0 0 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }

  /* Services */
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 88px;
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border-radius: 18px;
    border: 1px solid var(--border-soft);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0) 60%);
    transition:
      border-color 0.4s var(--ease-out-soft, ease),
      transform 0.4s var(--ease-out-soft, ease);
  }

  .service:hover {
    border-color: var(--border-medium);
    transform: translateY(-4px);
  }

  .service h3 {
    color: var(--text-primary);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .service p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .service ul {
    list-style: none;
    padding: 0;
    margin: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
  }

  .service li {
    color: var(--text-muted);
    font-size: 0.85rem;
    padding-left: 18px;
    position: relative;
  }

  .service li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-faint);
  }

  /* Shared section header */
  .proof-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 620px;
    margin-bottom: 32px;
  }

  .proof-header h2 {
    color: var(--text-primary);
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .proof-header p {
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.6;
    margin: 4px 0 0 0;
  }

  .proof {
    margin-bottom: 88px;
  }

  .product-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .product-strip a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px;
    border-radius: 16px;
    border: 1px solid var(--border-soft);
    background: rgba(255, 255, 255, 0.02);
    text-decoration: none;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .product-strip a:hover {
    border-color: var(--border-medium);
    background: rgba(255, 255, 255, 0.05);
  }

  .product-name {
    color: var(--text-primary);
    font-size: 1.25rem;
    letter-spacing: -0.04em;
  }

  .product-meta {
    color: var(--text-faint);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .product-domain {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 6px;
  }

  /* Track record */
  .track {
    margin-bottom: 88px;
  }

  .track-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .track-list li {
    padding: 24px 0;
    border-top: 1px solid var(--border-soft);
  }

  .track-list li:last-child {
    border-bottom: 1px solid var(--border-soft);
  }

  .track-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .track-head a {
    color: var(--text-primary);
    font-size: 1.375rem;
    letter-spacing: -0.04em;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .track-head a:hover {
    color: var(--text-muted);
  }

  .track-period {
    color: var(--text-faint);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .track-role {
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-style: italic;
    margin: 6px 0 0 0;
  }

  .track-note {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 8px 0 0 0;
    max-width: 70ch;
  }

  /* Closing */
  .closing {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 40px;
    border-radius: 20px;
    border: 1px solid var(--border-soft);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 100%);
  }

  .closing h2 {
    color: var(--text-primary);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .closing p {
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    max-width: 60ch;
  }

  @media (max-width: 1024px) {
    .services,
    .product-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .page-header {
      margin-bottom: 56px;
    }

    .services,
    .proof,
    .track {
      margin-bottom: 64px;
    }

    .services,
    .product-strip {
      grid-template-columns: 1fr;
    }

    .service {
      padding: 24px;
    }

    .closing {
      padding: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service,
    .product-strip a,
    .track-head a {
      transition: none;
    }

    .service:hover {
      transform: none;
    }
  }
</style>
