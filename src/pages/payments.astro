---
import Layout from '../layouts/layout.astro'
import {Icon} from 'astro-icon/components'
import credQR from '../assets/payments/cred-upi.jpeg'
import bhimQR from '../assets/payments/bhim-upi.jpeg'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Pay Soham Sarkar',
  description: 'Payment options to pay Soham Sarkar — UPI and bank transfer',
  url: 'https://sohamsarkar.com/payments',
}

const content = {
  title: 'Pay Soham - Payment Options | Soham Sarkar',
  description: 'Ways to pay Soham Sarkar — UPI QR codes and bank account details',
  ogImage: '/opengraph.png',
  structuredData,
  noindex: true,
}

const UPI_ID = 'soham-sarkar@axisb'

const bankDetails = [
  {label: 'Account Name', value: 'Soham Sarkar', copy: true},
  {label: 'Account Number', value: '77770109053682', copy: true},
  {label: 'IFSC Code', value: 'FDRL0007777', copy: true},
  {label: 'Alternate IFSC', value: 'FDRL0000001', copy: true},
  {label: 'Bank Name', value: 'Federal Bank', copy: false},
  {label: 'Branch', value: 'Neo Banking - Jupiter', copy: false},
]

const qrCodes = [
  {src: credQR.src, app: 'CRED', alt: 'CRED UPI QR code'},
  {src: bhimQR.src, app: 'BHIM', alt: 'BHIM UPI QR code'},
]

const paymentMethods = [
  {id: 'upi', title: 'UPI', icon: 'qr-code', description: 'Scan a QR code'},
  {id: 'bank', title: 'Bank Transfer', icon: 'bank', description: 'NEFT / IMPS / RTGS'},
]
---

<Layout content={content}>
  <main class="payments-page">
    <header class="page-header">
      <span class="page-label">Payments</span>
      <h1 class="page-title">Pay Soham</h1>
      <p class="page-description">
        Two ways to send money — scan a UPI QR code, or transfer straight to the bank account.
      </p>
    </header>

    <div class="method-switch" role="tablist" aria-label="Payment method">
      {
        paymentMethods.map((method, i) => (
          <button
            class="method-tab"
            role="tab"
            type="button"
            id={`tab-${method.id}`}
            aria-controls={`panel-${method.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={method.id}
          >
            <Icon name={method.icon} class="method-icon" />
            <span class="method-text">
              <span class="method-title">{method.title}</span>
              <span class="method-description">{method.description}</span>
            </span>
          </button>
        ))
      }
    </div>

    <section
      class="panel"
      role="tabpanel"
      id="panel-upi"
      aria-labelledby="tab-upi"
      data-section="upi"
    >
      <div class="qr-grid">
        {
          qrCodes.map(qr => (
            <figure class="qr-card">
              <img src={qr.src} alt={qr.alt} class="qr-image" loading="lazy" decoding="async" />
              <figcaption class="qr-app">{qr.app}</figcaption>
            </figure>
          ))
        }
      </div>

      <div class="field">
        <span class="field-label">UPI ID</span>
        <div class="copy-field">
          <span class="copy-text">{UPI_ID}</span>
          <button class="copy-btn" type="button" data-copy-btn={UPI_ID} aria-label="Copy UPI ID">
            <Icon name="copy" class="copy-icon" />
            <Icon name="check" class="check-icon" />
          </button>
        </div>
      </div>

      <p class="panel-note">Works with any UPI app — GPay, PhonePe, Paytm, CRED, BHIM.</p>
    </section>

    <section
      class="panel"
      role="tabpanel"
      id="panel-bank"
      aria-labelledby="tab-bank"
      data-section="bank"
      hidden
    >
      <div class="fields">
        {
          bankDetails.map(detail => (
            <div class="field">
              <span class="field-label">{detail.label}</span>
              <div class="copy-field">
                <span class="copy-text">{detail.value}</span>
                {detail.copy && (
                  <button
                    class="copy-btn"
                    type="button"
                    data-copy-btn={detail.value}
                    aria-label={`Copy ${detail.label.toLowerCase()}`}
                  >
                    <Icon name="copy" class="copy-icon" />
                    <Icon name="check" class="check-icon" />
                  </button>
                )}
              </div>
            </div>
          ))
        }
      </div>

      <p class="panel-note">Double-check the account number and IFSC before you send anything.</p>
    </section>
  </main>
</Layout>

<style>
  .payments-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 0 80px;
    color: var(--text-primary);
  }

  /* ---------- Header ---------- */
  .page-header {
    padding: 40px 0;
  }

  .page-label {
    display: inline-block;
    color: var(--text-faint);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 16px;
  }

  .page-title {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin: 0 0 20px 0;
  }

  .page-description {
    color: var(--text-dim);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
    max-width: 52ch;
  }

  /* ---------- Method switch ---------- */
  .method-switch {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }

  .method-tab {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    text-align: left;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-soft);
    border-radius: 16px;
    cursor: pointer;
    color: var(--text-muted);
    transition:
      background 0.2s var(--ease-out-soft),
      border-color 0.2s var(--ease-out-soft),
      color 0.2s var(--ease-out-soft);
  }

  .method-tab:hover {
    background: var(--surface-overlay-soft);
    border-color: var(--border-medium);
    color: var(--text-secondary);
  }

  .method-tab[aria-selected='true'] {
    background: var(--surface-overlay-soft);
    border-color: var(--border-medium);
    color: var(--text-primary);
  }

  .method-tab:focus-visible {
    outline: 2px solid var(--indigo-300);
    outline-offset: 2px;
  }

  .method-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--text-dim);
    transition: color 0.2s var(--ease-out-soft);
  }

  .method-tab[aria-selected='true'] .method-icon {
    color: var(--indigo-300);
  }

  .method-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .method-title {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: currentColor;
  }

  .method-description {
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  /* ---------- Panels ---------- */
  .panel {
    padding: 28px;
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-soft);
    border-radius: 20px;
    animation: panel-in 0.25s var(--ease-out-soft);
  }

  .panel[hidden] {
    display: none;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .panel-note {
    margin: 20px 0 0 0;
    font-size: 0.8125rem;
    color: var(--text-faint);
    line-height: 1.5;
  }

  /* ---------- QR codes ---------- */
  .qr-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .qr-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 16px;
    background: var(--surface-overlay-soft);
    border: 1px solid var(--border-soft);
    border-radius: 16px;
  }

  .qr-image {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 12px;
  }

  .qr-app {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-dim);
  }

  /* ---------- Fields ---------- */
  .fields {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }

  .copy-field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--surface-overlay-soft);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    transition:
      background 0.2s var(--ease-out-soft),
      border-color 0.2s var(--ease-out-soft);
  }

  .copy-field:hover {
    background: var(--surface-overlay-hover);
    border-color: var(--border-medium);
  }

  .copy-text {
    flex: 1;
    min-width: 0;
    font-size: 1rem;
    letter-spacing: -0.02em;
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  .copy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 4px;
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.2s var(--ease-out-soft);
  }

  .copy-btn:hover {
    transform: scale(1.1);
  }

  .copy-btn:active {
    transform: scale(0.95);
  }

  .copy-btn:focus-visible {
    outline: 2px solid var(--indigo-300);
    outline-offset: 2px;
  }

  .copy-icon,
  .check-icon {
    width: 18px;
    height: 18px;
    color: var(--text-dim);
  }

  .check-icon {
    display: none;
    color: #4ade80;
  }

  .copy-btn.copied .copy-icon {
    display: none;
  }

  .copy-btn.copied .check-icon {
    display: block;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 640px) {
    .page-header {
      padding: 24px 0 32px;
    }

    .method-switch {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .panel {
      padding: 20px;
    }

    .qr-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }

    .method-tab,
    .method-icon,
    .copy-field,
    .copy-btn {
      transition: none;
    }
  }
</style>

<script>
  function initPayments() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.method-tab'))
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'))

    function select(tab: HTMLButtonElement, focus = false) {
      tabs.forEach(t => {
        const isTarget = t === tab
        t.setAttribute('aria-selected', String(isTarget))
        t.tabIndex = isTarget ? 0 : -1
      })
      panels.forEach(p => {
        p.hidden = p.dataset.section !== tab.dataset.tab
      })
      if (focus) tab.focus()
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab))

      // Arrow keys move between tabs, as a tablist is expected to.
      tab.addEventListener('keydown', event => {
        const offset = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0
        if (offset === 0) return
        event.preventDefault()
        select(tabs[(index + offset + tabs.length) % tabs.length], true)
      })
    })

    document.querySelectorAll<HTMLButtonElement>('[data-copy-btn]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const textToCopy = btn.dataset.copyBtn
        if (!textToCopy) return

        try {
          await navigator.clipboard.writeText(textToCopy)
          btn.classList.add('copied')
          setTimeout(() => btn.classList.remove('copied'), 2000)
        } catch (err) {
          console.error('Failed to copy:', err)
        }
      })
    })
  }

  initPayments()
  document.addEventListener('astro:page-load', initPayments)
</script>
