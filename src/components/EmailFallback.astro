---
/*
  A mailto: link is a dead end on any machine with no mail client registered —
  the click does literally nothing and the visitor is left with a button that
  looks broken. This mounts once per page, watches every mailto: link on the
  document, and if the handoff to a mail app never happens it opens a small
  dialog with the ways out that always work: Gmail, Outlook, or the raw address
  on the clipboard.
*/
---

<dialog class="email-fallback" id="email-fallback" aria-labelledby="email-fallback-title">
  <div class="ef-body">
    <button class="ef-close" type="button" data-ef-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M6 6l12 12M18 6L6 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path></svg
      >
    </button>

    <h2 id="email-fallback-title">No mail app here</h2>
    <p class="ef-lede">
      Your device didn't have an email client to hand off to. Pick whichever of these suits you —
      they all reach the same inbox.
    </p>

    <div class="ef-actions">
      <a class="ef-action" data-ef-gmail href="#" target="_blank" rel="noopener noreferrer">
        <span>Compose in Gmail</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M7 17L17 7M9 7h8v8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
      <a class="ef-action" data-ef-outlook href="#" target="_blank" rel="noopener noreferrer">
        <span>Compose in Outlook</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M7 17L17 7M9 7h8v8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
    </div>

    <div class="ef-copy">
      <span class="ef-address" data-ef-address>&nbsp;</span>
      <button class="ef-copy-button" type="button" data-ef-copy>Copy</button>
    </div>
  </div>
</dialog>

<script>
  // How long to wait for the OS to take the page's focus away. A real handoff
  // fires blur/visibilitychange well inside this; a no-op mailto never does.
  const HANDOFF_MS = 900

  let pendingTimer: number | undefined
  let cleanup: (() => void) | undefined

  function dialogEl() {
    return document.getElementById('email-fallback') as HTMLDialogElement | null
  }

  /** Splits `mailto:a@b.com?subject=Hi&body=Yo` into its parts. */
  function parseMailto(href: string) {
    const withoutScheme = href.slice('mailto:'.length)
    const [addressPart, queryPart = ''] = withoutScheme.split('?')
    const params = new URLSearchParams(queryPart)
    return {
      address: decodeURIComponent(addressPart),
      subject: params.get('subject') ?? '',
      body: params.get('body') ?? '',
    }
  }

  function openDialog(href: string) {
    const dialog = dialogEl()
    if (!dialog) return

    const {address, subject, body} = parseMailto(href)
    const q = (extra: Record<string, string>) => {
      const params = new URLSearchParams(extra)
      return params.toString()
    }

    const gmail = dialog.querySelector<HTMLAnchorElement>('[data-ef-gmail]')
    const outlook = dialog.querySelector<HTMLAnchorElement>('[data-ef-outlook]')
    const addressEl = dialog.querySelector<HTMLElement>('[data-ef-address]')
    const copyButton = dialog.querySelector<HTMLButtonElement>('[data-ef-copy]')

    if (gmail) {
      gmail.href = `https://mail.google.com/mail/?${q({
        view: 'cm',
        fs: '1',
        to: address,
        su: subject,
        body,
      })}`
    }
    if (outlook) {
      outlook.href = `https://outlook.live.com/mail/0/deeplink/compose?${q({
        to: address,
        subject,
        body,
      })}`
    }
    if (addressEl) addressEl.textContent = address
    if (copyButton) {
      copyButton.textContent = 'Copy'
      copyButton.dataset.address = address
    }

    if (!dialog.open) dialog.showModal()
  }

  /** Anything that means the OS took over: the mailto worked, stand down. */
  function cancelPending() {
    if (pendingTimer !== undefined) {
      window.clearTimeout(pendingTimer)
      pendingTimer = undefined
    }
    cleanup?.()
    cleanup = undefined
  }

  function watchForHandoff(href: string) {
    cancelPending()

    const onLeave = () => cancelPending()
    const onVisibility = () => {
      if (document.visibilityState === 'hidden') cancelPending()
    }

    window.addEventListener('blur', onLeave)
    window.addEventListener('pagehide', onLeave)
    document.addEventListener('visibilitychange', onVisibility)

    cleanup = () => {
      window.removeEventListener('blur', onLeave)
      window.removeEventListener('pagehide', onLeave)
      document.removeEventListener('visibilitychange', onVisibility)
    }

    pendingTimer = window.setTimeout(() => {
      cancelPending()
      // Still here, still focused — nothing took the click.
      if (document.visibilityState === 'visible') openDialog(href)
    }, HANDOFF_MS)
  }

  // Delegated so it covers every mailto: link on the site, including ones a
  // <ClientRouter /> navigation swaps in after this script has run.
  document.addEventListener('click', event => {
    const target = event.target as Element | null
    const link = target?.closest?.('a[href^="mailto:"]') as HTMLAnchorElement | null
    if (!link) return
    // Let modified clicks (new tab, download, …) behave normally.
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
      return
    }
    watchForHandoff(link.href)
  })

  document.addEventListener('click', async event => {
    const target = event.target as Element | null

    if (target?.closest?.('[data-ef-close]')) {
      dialogEl()?.close()
      return
    }

    const copyButton = target?.closest?.('[data-ef-copy]') as HTMLButtonElement | null
    if (!copyButton) return

    const address = copyButton.dataset.address ?? ''
    try {
      await navigator.clipboard.writeText(address)
      copyButton.textContent = 'Copied'
      window.setTimeout(() => {
        copyButton.textContent = 'Copy'
      }, 2000)
    } catch {
      // Clipboard blocked (insecure context, denied permission) — select the
      // address instead so a manual copy is one keystroke away.
      const addressEl = document.querySelector('[data-ef-address]')
      if (!addressEl) return
      const range = document.createRange()
      range.selectNodeContents(addressEl)
      const selection = window.getSelection()
      selection?.removeAllRanges()
      selection?.addRange(range)
      copyButton.textContent = 'Press ⌘C'
    }
  })

  // Clicking the backdrop closes it — the dialog itself fills the whole
  // element, so a click landing on <dialog> is a click outside the card.
  document.addEventListener('click', event => {
    const dialog = dialogEl()
    if (dialog && event.target === dialog) dialog.close()
  })

  // A tab-switch or an app opening late shouldn't leave a stale dialog behind.
  document.addEventListener('astro:before-swap', () => {
    cancelPending()
    dialogEl()?.close()
  })
</script>

<style>
  .email-fallback {
    margin: auto;
    padding: 0;
    border: 1px solid var(--border-medium);
    border-radius: 20px;
    background: rgba(10, 10, 12, 0.92);
    color: var(--text-primary);
    max-width: min(440px, calc(100vw - 32px));
    width: 100%;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(18px);
    overflow: visible;
  }

  .email-fallback::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .ef-body {
    position: relative;
    padding: 28px;
    font-family: 'Victor Mono', monospace;
  }

  .ef-close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color 0.25s var(--ease-out-soft),
      border-color 0.25s var(--ease-out-soft);
  }

  .ef-close:hover {
    color: var(--text-primary);
    border-color: var(--border-soft);
  }

  .ef-close svg {
    width: 16px;
    height: 16px;
  }

  h2 {
    margin: 0 0 10px;
    padding-right: 32px;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .ef-lede {
    margin: 0 0 20px;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .ef-actions {
    display: grid;
    gap: 10px;
    margin-bottom: 16px;
  }

  .ef-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 16px;
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    background: var(--surface-overlay-soft);
    color: var(--text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition:
      background 0.25s var(--ease-out-soft),
      border-color 0.25s var(--ease-out-soft),
      color 0.25s var(--ease-out-soft);
  }

  .ef-action:hover {
    background: var(--surface-overlay-hover);
    border-color: var(--border-medium);
    color: var(--text-primary);
  }

  .ef-action svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .ef-copy {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 10px 10px 16px;
    border: 1px dashed var(--border-soft);
    border-radius: 12px;
  }

  .ef-address {
    flex: 1;
    min-width: 0;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    overflow-wrap: anywhere;
    user-select: all;
  }

  .ef-copy-button {
    flex-shrink: 0;
    padding: 8px 14px;
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    background: var(--surface-overlay-soft);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    transition:
      background 0.25s var(--ease-out-soft),
      border-color 0.25s var(--ease-out-soft);
  }

  .ef-copy-button:hover {
    background: var(--surface-overlay-hover);
    border-color: var(--border-medium);
  }

  .email-fallback:focus-visible,
  .ef-action:focus-visible,
  .ef-copy-button:focus-visible,
  .ef-close:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.75);
    outline-offset: 3px;
  }

  @media (max-width: 480px) {
    .ef-body {
      padding: 22px;
    }
  }
</style>
