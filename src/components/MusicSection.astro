---
import {Icon} from 'astro-icon/components'
import {fetchYouTubePlaylist, fallbackPlaylistData} from '../utils/youtube'

// Your YouTube Music playlist ID
const PLAYLIST_ID = 'PLvU9iXRGj0MQiHp6XSWJ3Q9veSGGrEZyS'

// Fetch playlist data from YouTube API
let musicData = fallbackPlaylistData

try {
  const apiKey = import.meta.env.YOUTUBE_API_KEY
  if (apiKey) {
    musicData = await fetchYouTubePlaylist(PLAYLIST_ID, apiKey)
  } else {
    console.warn('YOUTUBE_API_KEY not found in environment variables. Using fallback data.')
  }
} catch (error) {
  console.error('Failed to fetch YouTube playlist:', error)
  // musicData will use fallbackPlaylistData
}
---

<section class="music-page">
  <header class="page-header">
    <span class="page-label">Music</span>
    <h1 class="page-title">The soundtrack to my creative process</h1>
    <p class="page-description">{musicData.description}</p>
  </header>

  <div class="playlist-bar">
    <div class="playlist-meta">
      <h2 class="playlist-title">{musicData.title}</h2>
      <p class="playlist-count">{musicData.tracks.length} tracks · YouTube Music</p>
    </div>
    <div class="playlist-actions">
      <button id="shuffle-button" class="action action-primary" type="button">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M16 3h5v5"></path>
          <path d="M4 20L21 3"></path>
          <path d="M21 16v5h-5"></path>
          <path d="M15 15l6 6"></path>
          <path d="M4 4l5 5"></path>
        </svg>
        Shuffle
      </button>
      <a
        href={musicData.playlistUrl}
        class="action action-secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="youtubemusic" />
        Open playlist
      </a>
    </div>
  </div>

  <ol class="tracks-list">
    {
      musicData.tracks.map((track, index) => (
        <li class="track-row">
          <button
            class="track-item"
            type="button"
            data-video-id={track.videoId}
            aria-label={`Play ${track.title} by ${track.artist}`}
          >
            <span class="track-index" aria-hidden="true">
              <span class="track-number">{(index + 1).toString().padStart(2, '0')}</span>
              <svg class="track-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
            <span class="track-thumbnail">
              <img
                src={track.thumbnail}
                alt=""
                width="48"
                height="48"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="track-info">
              <span class="track-title">{track.title}</span>
              <span class="track-artist">{track.artist}</span>
            </span>
            <span class="track-duration">{track.duration}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <!-- Modal Backdrop -->
  <div id="modal-backdrop" class="modal-backdrop hidden">
    <!-- Modal Content -->
    <div
      id="music-player"
      class="music-player-modal"
      role="dialog"
      aria-modal="true"
      aria-label="Music player"
    >
      <div class="player-header">
        <div class="now-playing">
          <div class="now-playing-text">Now playing</div>
          <div class="current-track-info">
            <div class="current-track-title"></div>
            <div class="current-track-artist"></div>
          </div>
        </div>
        <button id="close-player" class="close-player" type="button" aria-label="Close player">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="player-frame"><div id="youtube-player"></div></div>
    </div>
  </div>
</section>

<style>
  .music-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 0 80px;
    color: var(--text-primary);
  }

  /* ---------- Header ---------- */
  .page-header {
    padding: 40px 0;
  }

  .page-label {
    display: inline-block;
    color: var(--text-faint);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 16px;
  }

  .page-title {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin: 0 0 20px 0;
    max-width: 16ch;
  }

  .page-description {
    color: var(--text-dim);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
    max-width: 52ch;
  }

  /* ---------- Playlist bar ---------- */
  .playlist-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 20px;
    margin-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .playlist-title {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 4px 0;
  }

  .playlist-count {
    font-size: 0.8125rem;
    color: var(--text-faint);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .playlist-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.2s var(--ease-out-soft),
      border-color 0.2s var(--ease-out-soft),
      color 0.2s var(--ease-out-soft),
      opacity 0.2s var(--ease-out-soft);
  }

  .action:focus-visible {
    outline: 2px solid var(--indigo-300);
    outline-offset: 2px;
  }

  .action-primary {
    background: var(--white);
    border: 1px solid var(--white);
    color: var(--black);
  }

  .action-primary:hover {
    opacity: 0.9;
  }

  .action-secondary {
    background: var(--surface-overlay-soft);
    border: 1px solid var(--border-soft);
    color: var(--text-secondary);
  }

  .action-secondary:hover {
    background: var(--surface-overlay-hover);
    border-color: var(--border-medium);
    color: var(--text-primary);
  }

  .action svg,
  .action :global(svg) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* ---------- Tracks ---------- */
  .tracks-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .track-row + .track-row {
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .track-item {
    display: grid;
    grid-template-columns: 2rem 48px 1fr auto;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 10px 12px;
    background: transparent;
    border: none;
    border-radius: 12px;
    color: inherit;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s var(--ease-out-soft);
  }

  .track-item:hover {
    background: var(--surface-overlay-soft);
  }

  .track-item:focus-visible {
    outline: 2px solid var(--indigo-300);
    outline-offset: -2px;
  }

  .track-index {
    display: grid;
    place-items: center;
    font-size: 0.8125rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* Number and play glyph share one cell so the row never reflows on hover. */
  .track-number,
  .track-play {
    grid-area: 1 / 1;
    transition: opacity 0.15s var(--ease-out-soft);
  }

  .track-play {
    opacity: 0;
    color: var(--text-primary);
  }

  .track-item:hover .track-number,
  .track-item:focus-visible .track-number {
    opacity: 0;
  }

  .track-item:hover .track-play,
  .track-item:focus-visible .track-play {
    opacity: 1;
  }

  .track-thumbnail {
    display: block;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-soft);
  }

  .track-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .track-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .track-title,
  .track-artist {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-title {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text-secondary);
  }

  .track-artist {
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .track-duration {
    font-size: 0.8125rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* Whichever track the player is on. */
  .track-row[data-playing='true'] .track-title,
  .track-row[data-playing='true'] .track-index {
    color: var(--indigo-300);
  }

  .track-row[data-playing='true'] .track-play {
    opacity: 1;
    color: var(--indigo-300);
  }

  .track-row[data-playing='true'] .track-number {
    opacity: 0;
  }

  /* ---------- Player modal ---------- */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    opacity: 1;
    transition: opacity 0.3s var(--ease-out-soft);
  }

  .modal-backdrop.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .music-player-modal {
    width: 100%;
    max-width: 760px;
    max-height: 90vh;
    border-radius: 20px;
    border: 1px solid var(--border-soft);
    background: rgba(10, 10, 10, 0.9);
    backdrop-filter: blur(10px);
    overflow: hidden;
    transform: scale(1);
    transition: transform 0.3s var(--ease-out-soft);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
  }

  .modal-backdrop.hidden .music-player-modal {
    transform: scale(0.97);
  }

  .player-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-soft);
  }

  .now-playing {
    min-width: 0;
  }

  .now-playing-text {
    font-size: 0.6875rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 6px;
  }

  .current-track-title {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .current-track-artist {
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .close-player {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    background: var(--surface-overlay-soft);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    color: var(--text-dim);
    cursor: pointer;
    transition:
      background 0.2s var(--ease-out-soft),
      color 0.2s var(--ease-out-soft);
  }

  .close-player:hover {
    background: var(--surface-overlay-hover);
    color: var(--text-primary);
  }

  .close-player:focus-visible {
    outline: 2px solid var(--indigo-300);
    outline-offset: 2px;
  }

  .player-frame {
    aspect-ratio: 16 / 9;
    max-height: calc(90vh - 80px);
    background: var(--black);
  }

  .player-frame :global(#youtube-player) {
    width: 100%;
    height: 100%;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .page-header {
      padding: 24px 0 32px;
    }

    .playlist-bar {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .playlist-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .action {
      justify-content: center;
    }

    .track-item {
      grid-template-columns: 1.75rem 40px 1fr auto;
      gap: 12px;
      padding: 10px 8px;
    }

    .track-thumbnail {
      width: 40px;
      height: 40px;
    }

    .modal-backdrop {
      padding: 1rem;
    }
  }

  @media (max-width: 480px) {
    .track-duration {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action,
    .track-item,
    .track-number,
    .track-play,
    .close-player,
    .modal-backdrop,
    .music-player-modal {
      transition: none;
    }
  }
</style>

<script>
  // YouTube IFrame Player API
  declare global {
    interface Window {
      YT: any
      onYouTubeIframeAPIReady: () => void
    }
  }

  let player: any = null
  let isPlayerReady = false
  // Set when a track is clicked before the iframe API has finished loading.
  let pendingVideoId: string | null = null

  // Load YouTube IFrame Player API
  if (!window.YT) {
    const tag = document.createElement('script')
    tag.src = 'https://www.youtube.com/iframe_api'
    const firstScriptTag = document.getElementsByTagName('script')[0]
    firstScriptTag.parentNode?.insertBefore(tag, firstScriptTag)
  }

  function createPlayer() {
    isPlayerReady = false
    player = new window.YT.Player('youtube-player', {
      height: '100%',
      width: '100%',
      playerVars: {
        playsinline: 1,
        autoplay: 0,
        controls: 1,
        rel: 0,
        modestbranding: 1,
      },
      events: {
        onReady: () => {
          isPlayerReady = true
          if (pendingVideoId) {
            player.loadVideoById(pendingVideoId)
            pendingVideoId = null
          }
        },
      },
    })
  }

  window.onYouTubeIframeAPIReady = createPlayer

  // A view transition swaps in a fresh #youtube-player div, orphaning the old
  // iframe. Rebuild the player whenever the mount point is a bare div again.
  function ensurePlayer() {
    const mount = document.getElementById('youtube-player')
    if (!mount || mount.tagName === 'IFRAME') return
    if (!window.YT?.Player) return // onYouTubeIframeAPIReady will handle it
    createPlayer()
  }

  function closePlayer() {
    document.getElementById('modal-backdrop')?.classList.add('hidden')
    document
      .querySelectorAll('.track-row[data-playing="true"]')
      .forEach(row => row.removeAttribute('data-playing'))
    pendingVideoId = null
    if (player && typeof player.pauseVideo === 'function') player.pauseVideo()
  }

  function playVideo(videoId: string, title: string, artist: string) {
    document.getElementById('modal-backdrop')?.classList.remove('hidden')

    const trackTitle = document.querySelector('.current-track-title')
    const trackArtist = document.querySelector('.current-track-artist')
    if (trackTitle) trackTitle.textContent = title
    if (trackArtist) trackArtist.textContent = artist

    document
      .querySelectorAll('.track-row[data-playing="true"]')
      .forEach(row => row.removeAttribute('data-playing'))
    document
      .querySelector(`.track-item[data-video-id="${videoId}"]`)
      ?.closest('.track-row')
      ?.setAttribute('data-playing', 'true')

    // Queue the track if the API is still loading — onReady picks it up.
    if (isPlayerReady) {
      player.loadVideoById(videoId)
    } else {
      pendingVideoId = videoId
      ensurePlayer()
    }
  }

  function playTrack(item: HTMLElement) {
    const videoId = item.dataset.videoId
    if (!videoId) return
    const title = item.querySelector('.track-title')?.textContent || ''
    const artist = item.querySelector('.track-artist')?.textContent || ''
    playVideo(videoId, title, artist)
  }

  let escapeListenerBound = false

  function initMusicSection() {
    ensurePlayer()

    document.getElementById('shuffle-button')?.addEventListener('click', () => {
      const items = document.querySelectorAll<HTMLElement>('.track-item')
      if (items.length === 0) return
      playTrack(items[Math.floor(Math.random() * items.length)])
    })

    document.querySelectorAll<HTMLElement>('.track-item').forEach(item => {
      item.addEventListener('click', () => playTrack(item))
    })

    document.getElementById('close-player')?.addEventListener('click', closePlayer)

    document.getElementById('modal-backdrop')?.addEventListener('click', e => {
      if (e.target === e.currentTarget) closePlayer()
    })

    // Bind once: document survives transitions, only attach the keydown listener a single time
    if (!escapeListenerBound) {
      document.addEventListener('keydown', e => {
        const backdrop = document.getElementById('modal-backdrop')
        if (e.key === 'Escape' && backdrop && !backdrop.classList.contains('hidden')) {
          closePlayer()
        }
      })
      escapeListenerBound = true
    }
  }

  initMusicSection()
  document.addEventListener('astro:page-load', initMusicSection)
</script>
