---
import {Image} from 'astro:assets'
import {productDomain, productUrl, type Product} from '../../data/products'
import {getTechIcon} from '../../data/tech'

export interface Props {
  product: Product
  index?: number
}

const {product, index = 0} = Astro.props

const href = productUrl(product.link)
const domain = productDomain(product.link)
const statusKey = product.status.toLowerCase().replace(/\s+/g, '-')
const marker = String(index + 1).padStart(2, '0')
const stack = product.stack
  .map(tech => ({tech, icon: getTechIcon(tech)}))
  .filter((item): item is {tech: string; icon: string} => item.icon !== null)

// The art keeps its own proportions now that there is no panel to fill, so
// nothing is ever cropped and the canvas overlay maps 1:1 to the image.
const aspect = product.image.width / product.image.height

// Never ask for a variant wider than the source: Ritua's export is 1024px, and
// a 1200px variant of it is an upscale — more bytes, no more detail. 1200 is
// the ceiling worth generating (620px column at 2x).
// 700 is the rung a 412px phone at 1.75x actually wants (it needs ~651). Left
// out, the next one up is 840 and it overshoots by a third.
const widest = Math.min(1200, product.image.width)
const widths = [560, 700, 840, 1200].filter(width => width < widest).concat(widest)
---

<article class="product reveal" data-pointer-card style={`--reveal-delay: ${index * 90}ms`}>
  <div class="product-visual" style={`--art-aspect: ${aspect}`}>
    <Image
      src={product.image}
      alt={`${product.title} — ${product.tagline}`}
      class="product-art"
      {/* Every row is below the fold, the first one included — it starts about
          a full viewport down. Loading it eagerly only put it in the same
          bandwidth queue as the hero plate, which is the LCP. */}
      loading="lazy"
      decoding="async"
      widths={widths}
      {/* Without this the <img src> fallback is the untouched source —
          SuperDivide's is 3684px and 219 KB, generated and deployed for a
          browser that will never ask for it. */}
      width={widest}
      {/* Not 100vw: the row sits inside .container's 20px gutters, so 100vw
          overstates the slot by ~11% — enough on a 412px phone to push the
          browser off the 700w rung and onto the 840w one. */}
      sizes="(max-width: 900px) calc(100vw - 40px), 620px"
    />
  </div>

  <div class="product-body">
    <p class="product-meta">
      <span class="product-marker">{marker}</span>
      <span class="product-rule" aria-hidden="true"></span>
      <span class="product-category">{product.category}</span>
    </p>

    <h3 class="product-title">{product.title}</h3>
    <p class="product-tagline">{product.tagline}</p>
    <p class="product-description">{product.description}</p>

    {/* Was a row of chips — the same words read as a line, with four fewer boxes. */}
    <p class="product-highlights">
      {
        product.highlights.map((item, position) => (
          <>
            {position > 0 && <span aria-hidden="true"> · </span>}
            {item}
          </>
        ))
      }
    </p>

    <div class="product-footer">
      <ul class="product-stack" aria-label="Built with">
        {
          /* role="img" belongs on the mark, not on the <li>. Put it on the
             list item and the item stops being a listitem, which both makes
             the role invalid for the element and leaves the <ul> holding
             children a list is not allowed to have. */
          stack.map(({tech, icon}) => (
            <li class="stack-chip">
              <span role="img" title={tech} aria-label={tech} set:html={icon} />
            </li>
          ))
        }
      </ul>

      <span class={`product-status status-${statusKey}`}>
        <span class="status-dot"></span>
        {product.status}
      </span>
    </div>

    {/* The only link in the row. Nothing else here claims to be pressable. */}
    <a class="product-link" href={href} target="_blank" rel="noopener noreferrer">
      <span class="product-link-label">{domain}</span>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
      <span class="sr-only">Open {product.title} in a new tab</span>
    </a>
  </div>
</article>

<script>
  // Feeds each row the pointer position so its surface light can track the
  // cursor — the same gesture as the buttons and the hero, so the whole page
  // reacts to one light source. Delegated at the document level: one listener
  // however many rows there are, and it survives a <ClientRouter /> swap.
  //
  // Nothing here touches the DOM inside the event. This listener used to read
  // a rect and then write two custom properties synchronously on every
  // pointermove, which dirtied layout for the rest of the frame — and the
  // WebGL effects each read a rect of their own on the same event, so every
  // mouse movement forced a fresh layout. Coalescing into one rAF means the
  // read and the write happen together, once per frame, after everyone else
  // has had their turn.
  //
  // Only on a device with a real cursor: on touch there is no hover state for
  // this to serve, and pointermove fires for every drag of a scroll.
  if (window.matchMedia('(pointer: fine)').matches) {
    let hovered: HTMLElement | null = null
    let clientX = 0
    let clientY = 0
    let frame = 0

    const paint = () => {
      frame = 0
      if (!hovered) return
      const rect = hovered.getBoundingClientRect()
      hovered.style.setProperty('--pointer-x', `${clientX - rect.left}px`)
      hovered.style.setProperty('--pointer-y', `${clientY - rect.top}px`)
    }

    document.addEventListener(
      'pointermove',
      (event: PointerEvent) => {
        const target = event.target as Element | null
        const card = target?.closest?.('[data-pointer-card]') as HTMLElement | null
        if (!card) {
          hovered = null
          return
        }
        hovered = card
        clientX = event.clientX
        clientY = event.clientY
        if (!frame) frame = requestAnimationFrame(paint)
      },
      {passive: true},
    )
  }
</script>

<style>
  /*
    No border, no radius, no filled panel. Each product is a row on the page
    separated by a hairline, which is also the honest presentation now that
    the row as a whole is not a link — a raised card would promise a click
    that only the domain below actually delivers.
  */
  .product {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 44px 0;
    border-top: 1px solid var(--border-soft);
  }

  /* Ambient attention, not a click affordance: the light says "you are here",
     the way the hero's pointer light does. */
  .product::before {
    content: '';
    position: absolute;
    inset: -1px 0 0;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(
      460px circle at var(--pointer-x, 50%) var(--pointer-y, 50%),
      rgba(255, 255, 255, 0.045),
      transparent 70%
    );
    transition: opacity 0.6s var(--ease-out-soft);
  }

  .product:hover::before,
  .product:focus-within::before {
    opacity: 1;
  }

  .product-visual {
    position: relative;
    z-index: 1;
    aspect-ratio: var(--art-aspect, 16 / 9);
    /*
      The art melts into the page instead of ending on a hard rectangle. Two
      axis gradients intersected rather than one radial: a radial wide enough
      not to eat the middle of a screenshot leaves the left and right edges
      fully opaque, which is the sharp vertical cut it was meant to remove.

      Edge-only — 8% a side softens the boundary without costing UI content.
      On the wrapper, not in the shader, so the plain <img> is feathered
      identically when WebGL never runs.
    */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 8%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    mask-image:
      linear-gradient(to right, transparent, #000 8%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  /* The art at rest, and the whole picture whenever the lens is not engaged. */
  .product-art {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .product-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 4px 0;
    color: var(--text-faint);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .product-marker {
    color: var(--text-muted);
  }

  .product-rule {
    width: 28px;
    height: 1px;
    background: var(--border-medium);
  }

  .product-title {
    color: var(--text-primary);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .product-tagline {
    color: var(--text-secondary);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-style: italic;
    line-height: 1.25;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .product-description {
    color: var(--text-dim);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 52ch;
    margin: 4px 0 0 0;
  }

  .product-highlights {
    color: var(--text-faint);
    font-size: 0.875rem;
    line-height: 1.7;
    max-width: 52ch;
    margin: 0;
  }

  .product-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 12px;
  }

  /* Logo-only — the mark is the label here, so the name lives in aria-label. */
  .product-stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stack-chip,
  .stack-chip span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* The svgl files carry their own width/height attributes; CSS beats those
     presentational hints, so one rule sizes every mark. */
  .stack-chip :global(svg) {
    width: 22px;
    height: 22px;
    /* Held back so the stack reads as a footnote, not a second logo wall.
       Comes up to full strength with the rest of the card on hover. */
    opacity: 0.55;
    transition: opacity 0.3s ease;
  }

  .product:hover .stack-chip :global(svg),
  .product:focus-within .stack-chip :global(svg) {
    opacity: 1;
  }

  .product-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--status-color, var(--text-muted));
    box-shadow: 0 0 8px var(--status-color, transparent);
  }

  .status-live {
    --status-color: #4ade80;
  }

  .status-beta {
    --status-color: #60a5fa;
  }

  .status-coming-soon {
    --status-color: #fbbf24;
  }

  /*
    The row's one interactive element, so it has to look like one on its own
    rather than borrowing the card's hover. Underline is drawn as a scaling
    rule so it wipes in from the left instead of blinking on.
  */
  .product-link {
    position: relative;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 4px 0;
    color: var(--text-muted);
    font-size: 1rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: color 0.3s var(--ease-out-soft);
  }

  .product-link-label {
    position: relative;
  }

  .product-link-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out-soft);
  }

  .product-link:hover,
  .product-link:focus-visible {
    color: var(--text-primary);
  }

  .product-link:hover .product-link-label::after,
  .product-link:focus-visible .product-link-label::after {
    transform: scaleX(1);
  }

  .product-link svg {
    transition: transform 0.3s var(--ease-out-soft);
  }

  .product-link:hover svg,
  .product-link:focus-visible svg {
    transform: translate(3px, -3px);
  }

  .product-link:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 6px;
    border-radius: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Wide: art and copy side by side, sides alternating down the list. */
  @media (min-width: 901px) {
    .product {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 64px;
      padding: 72px 0;
    }

    .product:nth-child(even) .product-visual {
      order: 2;
    }
  }

  @media (max-width: 768px) {
    .product {
      gap: 22px;
      padding: 36px 0;
    }

    .product-description {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product::before {
      display: none;
    }

    .product-art,
    .product-link,
    .product-link svg,
    .product-link-label::after {
      transition: none;
    }

    .product-link:hover svg,
    .product-link:focus-visible svg {
      transform: none;
    }
  }
</style>
