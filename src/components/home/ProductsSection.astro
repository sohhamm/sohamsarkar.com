---
import ProductCard from './ProductCard.astro'
import SpacetimeGrid from '../effects/SpacetimeGrid.astro'
import {products} from '../../data/products'
---

<section class="products-section" id="products">
  {/* Behind everything — reads the rows below to find its masses. */}
  <SpacetimeGrid />

  <div class="section-header reveal">
    <span class="section-label">Building</span>
    <h2 class="section-title">Products</h2>
    <p class="section-lede">
      Built, shipped, and still maintained. Each one started as a problem I hit often enough to go
      fix myself.
    </p>
  </div>

  <div class="products-list">
    {products.map((product, index) => <ProductCard product={product} index={index} />)}
  </div>
</section>

<style>
  .products-section {
    /* Positioning context for the lattice, which is absolutely placed. */
    position: relative;
    padding: 24px 0 40px;
    /* Offset the fixed nav when linked to via /#products. */
    scroll-margin-top: 120px;
  }

  /* Both above the lattice. */
  .section-header,
  .products-list {
    position: relative;
    z-index: 1;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 640px;
    margin-bottom: 44px;
  }

  /* Matches the Digital Backyard heading. */
  .section-header .section-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.08em;
  }

  .section-lede {
    color: var(--text-dim);
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 4px 0 0 0;
  }

  /* No gap: each row carries its own vertical padding and hairline rule, so
     the rules stay evenly spaced between rows rather than floating. */
  .products-list {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .products-section {
      scroll-margin-top: 84px;
    }

    .section-header {
      margin-bottom: 32px;
    }

    .section-lede {
      font-size: 1rem;
    }
  }
</style>
