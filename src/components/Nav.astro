  </button>

  <ul class="nav-links" id="nav-links">
    <li class="drawer-eyebrow" aria-hidden="true">menu</li>
    {
      LINKS.map(link => {
        const isActive =
          currentPath === link.to || (link.to !== '/' && currentPath.startsWith(link.to))
        return (
          <li
            class={`nav-item ${isActive ? 'active text-caption-italic-bold' : 'text-caption'}`}
            data-nav-item={link.name}
            data-nav-to={link.to}
          >
            <a
              href={link.to}
              class={`nav-link${isActive ? ' active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.name}
            </a>
          </li>
        )
      })
    }

