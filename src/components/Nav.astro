---
// The landing page is the product page, so `products` would only ever scroll
// the page you're already on. `/referrals` is intentionally unlinked.
export const LINKS = [
  {name: 'home', to: '/'},
  {name: 'work', to: '/work'},
  {name: 'about', to: '/about'},
  // {name: 'payments', to: '/payments'},
  // {name: 'music', to: '/music'},
]

const currentPath = Astro.url.pathname
