---
// Sits behind the Products section and bends around each product row.
// Pure enhancement: no content depends on it, it never takes pointer events,
// and it does not mount under reduced motion or without WebGL.
---

<div class="spacetime-field" aria-hidden="true">
  <canvas class="spacetime-grid" data-spacetime-grid></canvas>
</div>

<script>
  function initSpacetimeGrid() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const canvases = document.querySelectorAll<HTMLCanvasElement>(
      '[data-spacetime-grid]:not([data-mounted])',
    )
    if (!canvases.length) return

    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          observer.unobserve(entry.target)
          import('./spacetime-grid').then(({mountSpacetimeGrid}) =>
            mountSpacetimeGrid(entry.target as HTMLCanvasElement),
          )
        }
      },
      {rootMargin: '300px'},
    )

    canvases.forEach(canvas => observer.observe(canvas))
  }

  initSpacetimeGrid()
  document.addEventListener('astro:page-load', initSpacetimeGrid)
</script>

<style>
  /*
    Spans the section and breaks out of the 1200px container, so the lattice
    runs the full width of the viewport while the content stays in its column.
  */
  .spacetime-field {
    position: absolute;
    inset: 0;
    left: 50%;
    translate: -50% 0;
    width: 100vw;
    z-index: 0;
    pointer-events: none;
  }

  /*
    Sticky and one viewport tall, NOT the full height of the section. The
    section runs to ~2200px, which as a drawing buffer at 2x DPR would be
    ~16M pixels of memory to display one screenful. The field scrolls through
    a viewport-sized canvas instead; the shader re-reads where the rows are.
  */
  .spacetime-grid {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    max-width: none;
    opacity: 0;
    /* Fades at the screen edges, which also hides the sticky release. */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    transition: opacity 1.4s var(--ease-out-soft);
  }

  .spacetime-grid.is-ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .spacetime-grid {
      display: none;
    }
  }
</style>
